[flake8]
max-line-length = 88
extend-ignore = E203, W503
exclude =
    .git,
    __pycache__,
    .venv,
    tools,
    testing

per-file-ignores =
    # Standalone workflow scripts bootstrap sys.path intentionally and keep
    # verbose debug/report strings for traceability.
    examples/RAFM_irradiation/*.py: E402, E501, F401, F841
    # Legacy scientific modules under phased formatting migration.
    src/fluxforge/analysis/k0_naa.py: E501
    src/fluxforge/triga/cd_ratio.py: E501
    src/fluxforge/triga/k0.py: E501
