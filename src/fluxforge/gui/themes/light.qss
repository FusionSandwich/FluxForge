/* FluxForge Next light shell */
QWidget {
  background-color: #eef3f8;
  color: #1f2937;
  font-family: "Inter";
  font-size: 13px;
}

QMainWindow#FluxForgeMainWindow {
  background: qlineargradient(
    x1: 0, y1: 0, x2: 1, y2: 1,
    stop: 0 #f7fafc,
    stop: 0.55 #eef3f8,
    stop: 1 #dde7f1
  );
}

QMenuBar, QMenuBar::item {
  background: transparent;
  color: #243344;
}

QMenuBar::item:selected,
QMenu::item:selected {
  background-color: rgba(26, 108, 192, 0.10);
  border-radius: 8px;
}

QMenu {
  background-color: #ffffff;
  border: 1px solid rgba(91, 101, 118, 0.18);
  padding: 8px;
}

QToolBar#PrimaryToolbar {
  background-color: rgba(255, 255, 255, 0.80);
  border: 1px solid rgba(91, 101, 118, 0.14);
  border-radius: 16px;
  margin: 12px;
  padding: 10px 14px;
  spacing: 8px;
}

QDockWidget::title {
  text-align: left;
  background-color: rgba(183, 121, 31, 0.08);
  border-bottom: 1px solid rgba(91, 101, 118, 0.14);
  padding: 10px 14px;
  font-weight: 700;
}

QStatusBar#FluxForgeStatusBar {
  background-color: rgba(255, 255, 255, 0.88);
  border-top: 1px solid rgba(91, 101, 118, 0.12);
}

QProgressBar#StatusProgress {
  border: 1px solid rgba(91, 101, 118, 0.16);
  border-radius: 10px;
  background-color: #f7fafc;
  min-height: 20px;
  text-align: center;
}

QProgressBar#StatusProgress::chunk {
  background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0, stop: 0 #1a6cc0, stop: 1 #b7791f);
  border-radius: 9px;
}

QTabWidget::pane,
QTreeWidget,
QListWidget,
QPlainTextEdit,
QTextEdit,
QComboBox,
QLineEdit {
  background-color: #ffffff;
  border: 1px solid rgba(91, 101, 118, 0.16);
  border-radius: 14px;
}

QTabBar::tab {
  background-color: rgba(255, 255, 255, 0.86);
  border: 1px solid rgba(91, 101, 118, 0.14);
  border-bottom: none;
  border-top-left-radius: 12px;
  border-top-right-radius: 12px;
  padding: 10px 16px;
  margin-right: 6px;
}

QTabBar::tab:selected {
  background-color: rgba(26, 108, 192, 0.10);
  color: #0f2742;
}

QToolButton#ModeButton {
  background-color: rgba(255, 255, 255, 0.92);
  border: 1px solid rgba(91, 101, 118, 0.14);
  border-radius: 18px;
  padding: 8px 14px;
  font-weight: 700;
}

QToolButton#ModeButton:checked {
  background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #1a6cc0, stop:1 #b7791f);
  color: #ffffff;
  border-color: transparent;
}

QLabel#ModeMetaLabel {
  color: #5b6576;
  font-size: 12px;
  text-transform: uppercase;
}

QWidget#HeroCanvas,
QFrame#HeroCanvas {
  background: qlineargradient(
    x1: 0, y1: 0, x2: 1, y2: 1,
    stop: 0 rgba(26, 108, 192, 0.08),
    stop: 0.45 rgba(255, 255, 255, 0.94),
    stop: 1 rgba(183, 121, 31, 0.09)
  );
  border: 1px solid rgba(91, 101, 118, 0.16);
  border-radius: 24px;
}

QFrame#HeroCard {
  background-color: rgba(255, 255, 255, 0.92);
  border: 1px solid rgba(91, 101, 118, 0.14);
  border-radius: 18px;
}

QLabel#HeroEyebrow {
  color: #b7791f;
  font-size: 12px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

QLabel#HeroHeader,
QLabel#PanelHeading,
QLabel#HeroCardTitle {
  color: #14293f;
  font-size: 22px;
  font-weight: 800;
}

QLabel#HeroSubhead,
QLabel#PanelBody,
QLabel#HeroCardBody {
  color: #5b6576;
}

QLabel#HeroCardAccent {
  color: #1a6cc0;
  font-weight: 700;
}

QTreeWidget::item,
QListWidget::item {
  padding: 8px;
}
