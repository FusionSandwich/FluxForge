<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{{ title }}</title>
    <style>
      body { font-family: "IBM Plex Sans", sans-serif; margin: 24px; color: #10253c; }
      section { margin-bottom: 20px; padding: 16px; border: 1px solid #d8e3ec; border-radius: 14px; }
      pre { white-space: pre-wrap; word-break: break-word; }
    </style>
  </head>
  <body>
    <h1>{{ title }}</h1>
    <section><h2>ASTM Status Table</h2><div>{{ astm_status_table }}</div></section>
    <section><h2>QA Status Snapshot</h2><div>{{ qa_status_snapshot }}</div></section>
    <section><h2>Peak Table</h2><div>{{ peak_table }}</div></section>
    <section><h2>Activity Table</h2><div>{{ activity_table }}</div></section>
    {% if residuals_grid %}<section><h2>Residuals Grid</h2><div>{{ residuals_grid }}</div></section>{% endif %}
    <section><h2>Provenance</h2><pre>{{ provenance }}</pre></section>
  </body>
</html>
